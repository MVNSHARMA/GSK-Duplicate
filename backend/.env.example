# Server Configuration
PORT=5001
NODE_ENV=production
FRONTEND_URL=https://your-frontend-domain.com

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=GSKAutomotive

# Security
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRE=30d
DEFAULT_ADMIN_EMAIL=admin@gskautomotive.com
DEFAULT_ADMIN_PASSWORD=your_secure_password_here
CRON_SECRET=your_cron_secret_key

# Cloudinary Configuration (For Image/File Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin Email (For internal company notifications fallback)
ADMIN_EMAIL=admin@gskautomotive.com

# Brevo Transactional Email Configuration
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME="GSK Automotive"
BREVO_REPLY_TO_EMAIL=your_reply_to@example.com
